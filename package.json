{
  "name": "@codeuxai/codeux",
  "version": "0.9.11",
  "description": "Containerized environment for running and managing AI sub-agents",
  "author": "Pierre Voss <p.voss@codeux.ai>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codeux-ai/codeux.git"
  },
  "bugs": {
    "url": "https://github.com/codeux-ai/codeux/issues"
  },
  "homepage": "https://github.com/codeux-ai/codeux#readme",
  "packageManager": "pnpm@11.13.1",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "codeux": "dist/index.js",
    "codeux-worker": "dist/worker/index.js"
  },
  "files": [
    "dist",
    "dashboard/dist",
    ".code-ux/agents/planning_agent.md",
    ".code-ux/agents/project_manager.md",
    ".code-ux/agents/project_setup_agent.md",
    ".code-ux/agents/quality_assurance_agent.md",
    ".code-ux/agents/worker.md",
    ".code-ux/container/setup.sh",
    ".code-ux/embeddings/codeux-internaldocs.bge-small-en-v1.5.json",
    ".code-ux/nodes/README.md",
    ".code-ux/quicksprints/templates/qs-code-quality.md",
    ".code-ux/quicksprints/templates/qs-create-desktop-app.md",
    ".code-ux/quicksprints/templates/qs-create-game.md",
    ".code-ux/quicksprints/templates/qs-create-online-shop.md",
    ".code-ux/quicksprints/templates/qs-create-portfolio.md",
    ".code-ux/quicksprints/templates/qs-create-web-app.md",
    ".code-ux/quicksprints/templates/qs-security.md",
    ".code-ux/quicksprints/templates/qs-ui-a11y.md",
    ".code-ux/quicksprints/templates/qs-ui-design.md",
    ".code-ux/quicksprints/templates/qs-ui-interactions.md",
    ".code-ux/quicksprints/templates/qs-ui-responsive.md",
    "docs",
    "docs-web",
    "assets",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "pnpm run build",
    "start": "node dist/index.js",
    "dev": "node scripts/dev.mjs",
    "dev:server-only": "node --import ./scripts/tsnode-register.mjs src/index.ts",
    "electron:generate-icons": "node scripts/generate-electron-icons.mjs",
    "electron:prepare-deps": "node scripts/prepare-electron-runtime-deps.mjs && pnpm run electron:generate-icons",
    "electron:dev": "pnpm run build && electron dist/electron/main.js",
    "electron:pack": "pnpm run build && pnpm run electron:prepare-deps && electron-builder --config electron-builder.config.cjs --dir",
    "electron:dist": "pnpm run build && pnpm run electron:prepare-deps && electron-builder --config electron-builder.config.cjs",
    "electron:dist:linux": "pnpm run build && pnpm run electron:prepare-deps && electron-builder --config electron-builder.config.cjs --linux",
    "electron:dist:mac": "pnpm run build && pnpm run electron:prepare-deps && electron-builder --config electron-builder.config.cjs --mac",
    "electron:dist:win": "pnpm run build && pnpm run electron:prepare-deps && electron-builder --config electron-builder.config.cjs --win",
    "electron:benchmark:runtime": "node scripts/benchmark-electron-runtime.mjs",
    "electron:benchmark:win": "node scripts/benchmark-electron-windows.mjs",
    "electron:smoke-installed": "node scripts/smoke-installed-electron.mjs",
    "electron:install-deps": "electron-builder install-app-deps",
    "test": "vitest run",
    "smoketest:codex": "node --import ./scripts/tsnode-register.mjs tests/smoketest/codex.smoketest.ts",
    "test:backend": "vitest run tests/backend",
    "test:dashboard": "vitest run tests/dashboard",
    "test:e2e": "node scripts/e2e/run-playwright.mjs",
    "test:e2e:credentialed-automation": "vitest run tests/backend/services/credentialed-automation-e2e.test.ts",
    "test:e2e:mockup-sprint-pentest": "node scripts/e2e/run-mockup-sprint-pentest.mjs",
    "test:orchestration:rapid": "vitest run tests/backend/services/virtual-worker-service.test.ts tests/backend/infrastructure/providers/cli/provider-runner.test.ts tests/backend/services/provider-routing.test.ts tests/backend/sprint/watch-loop-core.test.ts tests/backend/domain/sprint/ci/feature-pr-gate.test.ts tests/backend/infrastructure/git/local-merge.test.ts",
    "test:orchestration:ci-dag": "pnpm run build && pnpm run test:orchestration:ci-dag:run",
    "test:orchestration:ci-dag:run": "node scripts/e2e/run-mockup-sprint-pentest.mjs --execution-mode docker --scenario ci-qa-dag --timeout-ms 1200000 --stall-timeout-ms 180000 --restart-every-ms 5000 --restart-count 2",
    "test:orchestration:ci-dag:electron": "pnpm run build && pnpm run test:orchestration:ci-dag:electron:run",
    "test:orchestration:ci-dag:electron:run": "node scripts/e2e/run-mockup-sprint-pentest.mjs --runtime electron --execution-mode fixture --scenario ci-qa-dag-electron --timeout-ms 1200000 --stall-timeout-ms 180000",
    "test:orchestration:merge-e2e": "pnpm run build && node scripts/e2e/run-mockup-sprint-pentest.mjs --scenario merge-conflict-dag --timeout-ms 900000",
    "test:orchestration:completion-conflict": "pnpm run build && node scripts/e2e/run-mockup-sprint-pentest.mjs --scenario completion-merge-conflict --timeout-ms 1200000",
    "test:orchestration:full": "pnpm run build && pnpm run test:e2e:mockup-sprint-pentest",
    "test:orchestration:large-dag": "pnpm run build && node scripts/e2e/run-mockup-sprint-pentest.mjs --scenario large-dag-stress --timeout-ms 3600000",
    "test:orchestration:pentest": "pnpm run build && node scripts/e2e/run-mockup-sprint-pentest.mjs --scenario pentest --timeout-ms 3600000",
    "test:orchestration:extreme-dag": "pnpm run build && node scripts/e2e/run-mockup-sprint-pentest.mjs --scenario extreme-dag-recovery --timeout-ms 7200000 --stall-timeout-ms 300000 --restart-every-ms 30000 --restart-count 8",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:backend:coverage": "vitest run tests/backend --coverage",
    "check:dashboard-i18n": "node scripts/check-dashboard-i18n.mjs",
    "quality:guardrails": "node scripts/check-quality-guardrails.mjs",
    "sync:docs-web": "node scripts/sync-docs-web.mjs",
    "check:docs-web": "node scripts/sync-docs-web.mjs --check",
    "lint": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tsc/root.tsbuildinfo",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tsc/root.tsbuildinfo",
    "ci": "pnpm run quality:guardrails && pnpm run audit && pnpm run lint && pnpm run test:backend:coverage && pnpm run test:dashboard && pnpm run build",
    "audit": "pnpm audit --audit-level=high",
    "smoke-test": "node dist/index.js --help",
    "build:server": "tsc --incremental --tsBuildInfoFile .cache/tsc/server-build.tsbuildinfo",
    "build:dashboard": "tsc -p dashboard/tsconfig.json --noEmit --incremental --tsBuildInfoFile .cache/tsc/dashboard.tsbuildinfo && vite build",
    "dev:dashboard": "vite",
    "typecheck:dashboard": "tsc -p dashboard/tsconfig.json --noEmit --incremental --tsBuildInfoFile .cache/tsc/dashboard.tsbuildinfo"
  },
  "dependencies": {
    "@anthropic-ai/tokenizer": "^0.0.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ajv": "^8.20.0",
    "axios": "^1.18.1",
    "colord": "^2.9.3",
    "dotenv": "^17.4.2",
    "escape-html": "^1.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "js-tiktoken": "^1.0.21",
    "mammoth": "^1.12.0",
    "multer": "^2.2.0",
    "onnxruntime-node": "^1.27.0",
    "p-limit": "^7.3.0",
    "pdf-parse": "^2.4.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@playwright/test": "^1.61.1",
    "@preact/preset-vite": "^2.10.5",
    "@preact/signals": "^2.9.4",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "1.170.18",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/user-event": "^14.6.1",
    "@types/escape-html": "^1.0.4",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.2",
    "@types/supertest": "^7.2.1",
    "@types/three": "^0.185.1",
    "@vitest/coverage-v8": "^4.1.10",
    "electron": "43.2.0",
    "electron-builder": "26.15.7",
    "gsap": "^3.15.0",
    "happy-dom": "^20.10.6",
    "jsdom": "^30.0.1",
    "lucide-preact": "^1.24.0",
    "lucide-react": "^1.24.0",
    "marked": "^18.0.6",
    "monaco-editor": "^0.56.0",
    "preact": "^10.29.7",
    "react": "^19.2.7",
    "react-arborist": "^3.13.2",
    "react-dom": "^19.2.7",
    "react-is": "^19.2.7",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
